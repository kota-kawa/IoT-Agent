[Unit]
Description=My Python App (run in venv, from HOME)
After=network.target

[Service]
Type=simple

# 実行ユーザー
User=pi

# 作業ディレクトリ
WorkingDirectory=/home/pi/myproject

# 仮想環境内のPythonを直接指定
ExecStart=/home/pi/myproject/venv/bin/python /home/pi/myproject/main.py

# 落ちたら自動再起動したい場合
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
