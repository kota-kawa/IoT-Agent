# ==========================================
# LLM Provider API Keys
# ==========================================
# At least one provider key is required for AI features.

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_ORG_ID=org-optional
# OPENAI_PROJECT_ID=proj-optional

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google (Gemini)
# GEMINI_API_KEY=your-gemini-api-key-here

# Groq
# GROQ_API_KEY=gsk-your-groq-api-key-here

# ==========================================
# Application Security & Settings
# ==========================================
# Password for the web interface (default is often empty or checked in code)
APP_PASSWORD=secure-password-for-ui

# Secret key for Flask session signing. Change this to a random string!
FLASK_SECRET_KEY=change-this-to-a-long-random-string

# Base URL for the Multi-Agent Platform Orchestrator (if running in that context)
MULTI_AGENT_PLATFORM_BASE=http://web:5050

# Path to shared model settings (optional)
# MULTI_AGENT_SETTINGS_PATH=/path/to/shared/settings.json

# Base URL where this IoT Agent is accessible (optional, for self-reference)
# IOT_AGENT_API_BASE_URL=http://localhost:5006

# Vision model specifier (optional)
# IOT_VISION_MODEL=gpt-4-vision-preview

# ==========================================
# Storage Configuration (Optional)
# ==========================================
# By default, the agent uses in-memory storage. 
# To use Redis or Postgres, configure the following:

# Storage Backend: 'memory', 'redis', or 'auto'
IOT_AGENT_STORAGE_BACKEND=memory

# Redis Configuration (if using Redis)
# REDIS_URL=redis://redis:6379/0
# IOT_AGENT_REDIS_PREFIX=iot_agent

# Database Configuration (if using Postgres via SQLAlchemy in future extensions)
# DATABASE_URL=postgresql://user:password@localhost/dbname

# Postgres Container Environment Variables (for docker-compose)
POSTGRES_DB=iot_agent
POSTGRES_USER=iot_agent
POSTGRES_PASSWORD=secure-postgres-password

# ==========================================
# Job & Execution Settings
# ==========================================
# Time to keep job results (in seconds)
IOT_AGENT_JOB_RESULT_TTL=3600

# Max number of completed jobs to keep in history
MAX_COMPLETED_JOBS=200

# Timeout for device to return results (seconds)
DEVICE_RESULT_TIMEOUT=300.0
